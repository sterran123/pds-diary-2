rules_version = '2';
// 플랜두씨 다이어리 2 — 사용자별 문서 잠금
//
// 구조: diaries/{uid} 문서 하나가 한 사람의 다이어리 전체를 담는다.
//   - request.auth.uid == uid  → 본인 문서만 읽기·쓰기 가능 (남의 문서는 403 PERMISSION_DENIED)
//   - auth_time > revokedAtSec → 로그아웃·비밀번호 변경으로 찍어 둔 무효화 시각보다
//                                새로 발급된 토큰만 통한다. 로그아웃 뒤 같은 토큰은 거절된다.
//   - 없는 문서를 get하면 규칙이 통과하고 서버가 404를 돌려준다 → 앱이 첫 이주를 할 수 있다.
//     (exists()로 가드하지 않으면 없는 문서의 resource.data 평가가 실패해 403이 된다)
//   - create는 revokedAtSec 검사를 빼 둔다 → 새 계정의 첫 문서(이주 포함)가 막히지 않게.
//   - list(컬렉션 질의)는 허용하지 않는다 → 목록에 남의 자료가 섞일 경로가 없다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    match /diaries/{uid} {
      function selfDoc() {
        return /databases/$(database)/documents/diaries/$(uid);
      }
      function freshToken() {
        return !exists(selfDoc())
          || request.auth.token.auth_time > get(selfDoc()).data.get('revokedAtSec', 0);
      }
      allow get: if signedIn() && request.auth.uid == uid && freshToken();
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && request.auth.uid == uid && freshToken();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
